# Переменные окружения для MedoEDUz

# Окружение
NODE_ENV=development

# API Configuration
API_URL=http://localhost:3000/v1
API_TIMEOUT=10000

# Database (для будущей разработки)
DATABASE_URL=postgresql://user:password@localhost:5432/medoeduz
DB_USER=medoeduz
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medoeduz

# JWT Secrets
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@medoeduz.com

# Payment Gateway (Например, Stripe)
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloud Storage (Например, AWS S3)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=medoeduz-uploads

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
YANDEX_METRIKA_ID=XXXXXXXX

# Social Media
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# CORS
CORS_ORIGIN=https://medoeduz.com,https://www.medoeduz.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400000

# Uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Redis (для кэширования)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Sentry (мониторинг ошибок)
SENTRY_DSN=https://your-sentry-dsn-here

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_PAYMENT=false
ENABLE_BLOG=false
MAINTENANCE_MODE=false
